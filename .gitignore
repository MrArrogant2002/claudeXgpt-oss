.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
.eggs/
*.egg-info/
dist/
build/
pip-wheel-metadata/
*.whl

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and local runtime data
*.log
logs/
tmp/
temp/

# Local model downloads and generated artifacts
models/
checkpoints/
outputs/
artifacts/
wandb/
mlruns/

# Harmony tokenizer vocab — downloaded once per machine (see vendor/tiktoken/README.md).
# Keep the README + docs; ignore the ~3.6MB vocab blobs.
vendor/tiktoken/*
!vendor/tiktoken/README.md

# Reversible backups written by the edit/write tools (per-project).
.agent-backups/

# `local init` machine-state sidecar (the human-readable local_mind.md is yours to
# keep/commit; this fingerprint is regenerated and would only add diff noise).
.local_mind.sig.json

# Eval harness outputs (per-run reports + throwaway fixture copies).
tests/eval/reports/
tests/eval/.work/
Springer_Nature_LaTeX_Template