% ============ Core: control-token security and tokenization ================

@article{zhan2026samebytes,
  title   = {Same Bytes, Different Authority: Reserved-Token Representations
             in Chat-Template Prompt Injection},
  author  = {Zhan, Yan and Song, Yunze and Hou, Mengkai and Zhang, Wanting
             and Liu, Shaobo and Gao, Zhijun},
  journal = {arXiv preprint arXiv:2609.35932},
  year    = {2026},
  note    = {[READ IN FULL, 28 pp, 2026-10-07] Full title begins "Byte
             Authority". Peking Univ., NUS, BYD, Shenzhen Univ. Subword
             encoding of forged markers lowers attack success by 39--66 pp on
             three of four open-weight families; Qwen3-8B gap is 8 pp, rising
             to 50 when the reasoning block is suppressed. Authority localises
             to the single learned vector. Instruction tuning strengthens the
             preference for reserved markers. 33 of 67 tokenizer
             configurations -- 255 of the 400 most-downloaded chat models --
             leave tool-protocol tokens intact. THE KEY SENTENCE FOR US
             (App. G.2): "Llama-3.1, Llama-3.3 and gpt-oss declare no such
             tokens", so gpt-oss-20b/120b appear in the audit table (2 role
             markers, 0 tool-protocol tokens) and are EXCLUDED from the
             tool-channel experiment. "Harmony" occurs 0 times in 28 pages.
             Code: github.com/Byte-Authority},
  url     = {https://arxiv.org/abs/2609.35932}
}

@article{yang2026nameless,
  title   = {Nameless Tokenization: A Lossless Tokenizer-Level Defense Against
             Control-Token Forgery in Open-Weight LLMs},
  author  = {Yang, Kisu and Jang, Yoonna and Lim, Heuiseok},
  journal = {arXiv preprint arXiv:2609.16984},
  year    = {2026},
  note    = {[READ] Removes surface strings from control tokens while
